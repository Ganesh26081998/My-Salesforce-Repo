<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_Referral_When_Account_Deactivate</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Patient__c)),
    Patient__r.Is_Deactivated__c = TRUE
)</errorConditionFormula>
    <errorMessage>You cannot create or edit this Referral because the related Account is deactivated</errorMessage>
</ValidationRule>
